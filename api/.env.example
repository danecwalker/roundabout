DATABASE_URL=postgres://roundabout:roundabout@localhost:5432/roundabout
REDIS_URL=redis://localhost:6379
BIND_ADDR=0.0.0.0:8790
# Public origin the widget and frame are served from.
PUBLIC_URL=http://localhost:8790
# Extra origin allowed to embed any widget (the dashboard dev server, for its "Try it" panel).
DASHBOARD_ORIGIN=http://localhost:5180
WIDGET_DIR=../widget/dist
DASHBOARD_DIR=../dashboard/dist
COOKIE_SECURE=false
# Set to false to stop new accounts; invite links still work, and the very first
# account on a fresh instance can always be created (it becomes the admin).
ALLOW_SIGNUP=true
TOKEN_TTL_SECS=300
CHALLENGE_TTL_SECS=120
RUST_LOG=roundabout_api=debug,tower_http=info
# HMAC key for device/ephemeral IDs. Generate with: openssl rand -hex 32
SERVER_SECRET=
# Network reputation: fetch cloud/Tor IP lists on boot and every 6h.
NETREP_FETCH=true
# Optional MaxMind GeoLite2 databases (free account): ASN and City (for timezone checks).
MAXMIND_ASN_DB=
MAXMIND_CITY_DB=
# Optional extra ranges file, one "CIDR category label" per line (category: datacenter|vpn|tor).
NETREP_EXTRA_FILE=
# Private Access Tokens (Privacy Pass). Issuer whose public key we verify against.
PAT_ENABLED=true
PAT_ISSUER=demo-pat.issuer.cloudflare.com
